---
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { artworkImage } from '../data/images';
import { clubImage } from '../lib/club-images';
import { defaultLocale, getLocale, locales, pagePath, useTranslations } from '../i18n';

import '@fontsource-variable/inter';
import '@fontsource/special-gothic-expanded-one/400.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource-variable/lexend';
import bodyFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import headingFontUrl from '@fontsource/special-gothic-expanded-one/files/special-gothic-expanded-one-latin-400-normal.woff2?url';
import vietnameseBodyFontUrl from '@fontsource-variable/inter/files/inter-vietnamese-wght-normal.woff2?url';
import vietnameseHeadingFontUrl from '@fontsource-variable/lexend/files/lexend-vietnamese-wght-normal.woff2?url';
import lexendLatinFontUrl from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import preferencesScript from '../scripts/preferences.js?raw';
import globalCss from '../styles/global.css?raw';
import '../styles/global.css';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

interface Props {
  title?: string; description?: string; socialTitle?: string; socialDescription?: string;
  image?: string; noindex?: boolean; schema?: unknown; pageSlug?: string;
}

const {
  title = t('meta.title'),
  description = t('meta.description'),
  socialTitle = t('meta.socialTitle'),
  socialDescription = t('meta.socialDescription'),
  image = clubImage(artworkImage.file).src, noindex = false, schema, pageSlug
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isVietnamese = locale === 'vi';
const preloadFonts = isVietnamese
  ? [lexendLatinFontUrl, vietnameseHeadingFontUrl, bodyFontUrl, vietnameseBodyFontUrl]
  : [headingFontUrl, bodyFontUrl];
const [, lightTheme = '#98472e', darkTheme = '#291b22'] = globalCss.match(/--canvas:\s*light-dark\((#[0-9a-fA-F]+),\s*(#[0-9a-fA-F]+)\)/) ?? [];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="text-scale" content="scale" />
    <meta name="theme-color" content={lightTheme} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={darkTheme} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && locales.map((locale) => <link rel="alternate" hreflang={locale} href={new URL(pagePath(locale, pageSlug), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(pagePath(defaultLocale, pageSlug), Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={isVietnamese ? 'vi_VN' : 'en_US'} />
    <meta property="og:locale:alternate" content={isVietnamese ? 'en_US' : 'vi_VN'} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <script is:inline set:html={preferencesScript} />
    <slot name="head" />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <SiteHeader pageSlug={pageSlug} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter pageSlug={pageSlug} />
  </body>
</html>

<style>
  .skip-link { position: fixed; top: -10rem; left: 1rem; padding: .875rem 1.25rem; background: var(--surface); color: var(--text); z-index: 100; border-radius: .625rem; font-size: var(--text-ui); text-decoration: underline; }
  .skip-link:focus { top: 1rem; }
</style>
