---
import type { Product } from '../../data/products';
import Icon from '../Icon.astro';
import Button from '../ui/Button.astro';
import ProductIcon from './Icon.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

interface Props {
  product: Product;
  id: string;
}

const { product, id } = Astro.props;
const newTab = !product.url.startsWith('/');
---
<dialog id={id} class="product-dialog" closedby="any" aria-labelledby={`${id}-title`}>
  <form method="dialog">
    <button class="dialog-close" aria-label={t('products.closeDetails')} autofocus><Icon name="close" size={18} /></button>
  </form>
  <ProductIcon name={product.icon} variant={product.preview} size={25} large />
  <h2 id={`${id}-title`}>{product.name}</h2>
  <p class="dialog-summary">{product.summary}</p>
  <p>{product.detail}</p>
  <div class="dialog-actions">
    <Button href={product.url} icon={newTab ? 'diagonal' : 'arrow'}
      target={newTab ? '_blank' : undefined} rel={newTab ? 'noopener noreferrer' : undefined}>
      {t('products.open', { name: product.name })}
      {newTab && <span slot="suffix" class="sr-only"> {t('products.newTabSuffix')}</span>}
    </Button>
    {product.sourceUrl && (
      <a class="product-source" href={product.sourceUrl} aria-label={t('products.sourceLabel', { name: product.name })}>
        <Icon name="github" size={16} />
        <span>{t('products.source')}</span>
      </a>
    )}
  </div>
</dialog>

<style>
  .product-dialog { width: min(34rem, calc(100% - 2rem)); }
  h2 { font-size: calc(1.8125rem * var(--text-scale)); line-height: 1.3; letter-spacing: -.035em; }
  p { color: var(--muted); font-size: var(--text-body); line-height: 1.8; margin-top: 1rem; }
  .dialog-summary { color: var(--accent); }
  .dialog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.75rem; }
  .product-source {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-block-size: 44px;
    font-size: var(--text-ui);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  @media (max-width: 44em) { .product-dialog { padding-inline: 1.5rem; } }
</style>
