---
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
---
<section class="about-section content-width" id="about" aria-labelledby="about-title">
  <div class="about-copy">
    <h2 id="about-title">{t('about.titleLine1')}<br />{t('about.titleLine2')}</h2>
    <p>{t('about.description')}</p>
    <a class="text-link" href="#products">{t('about.cta')} <Icon name="arrow" size={19} /></a>
  </div>
  <img class="about-art" src="/images/club-artwork.webp" alt={t('about.imageAlt')} width="1400" height="788" loading="lazy" />
</section>

<style>
  .about-section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 3rem; align-items: center; padding-block: 4rem 4.5rem; }
  h2 { font-size: calc(clamp(2rem, 1.4rem + 1.5vw, 3.25rem) * var(--text-scale)); font-weight: var(--heading-weight); line-height: 1.15; letter-spacing: -.06em; }
  .about-copy p { color: var(--canvas-muted); font-size: var(--text-body); line-height: 1.75; margin-top: 1.5rem; max-width: 50ch; }
  .text-link { display: inline-flex; align-items: center; gap: .875rem; color: var(--canvas-text); min-height: 44px; padding-block: .5rem; margin-top: 1rem; text-decoration: underline; text-underline-offset: .2em; font-size: var(--text-ui); }
  .about-art { display: block; width: 100%; height: auto; aspect-ratio: 1.8 / 1; object-fit: cover; border-radius: 8rem 8rem .75rem 8rem; }
  @media (max-width: 52em) { .about-section { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }
</style>
