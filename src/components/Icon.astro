---
import type { HTMLAttributes } from 'astro/types';
import { contactIconPaths } from '../data/contact';

const paths = {
  accessibility: '<circle cx="12" cy="4" r="2"/><path d="m4 8 8 2 8-2M12 10v5m0 0-5 6m5-6 5 6"/>',
  arrow: '<path d="M4 12h16m-6-6 6 6-6 6"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  code: '<path d="m8 6-6 6 6 6m8-12 6 6-6 6m-2-14-4 16"/>',
  diagonal: '<path d="M6 18 18 6M6 6h12v12"/>',
  sparkle: '<path d="m12 3 2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3Z"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>',
  close: '<path d="m6 6 12 12M6 18 18 6"/>',
  ...contactIconPaths
};

export type IconName = keyof typeof paths;
interface Props extends HTMLAttributes<'svg'> { name?: IconName; size?: number; }
const { name = 'arrow', size = 20, ...attributes } = Astro.props;
---
<svg {...attributes} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name] || paths.arrow} />
