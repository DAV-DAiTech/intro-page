---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import ProductCollection from '../products/Collection.astro';
import About from '../sections/About.astro';
import ClubNotes from '../sections/ClubNotes.astro';
import { getProducts } from '../../data/products';
import { homePath, useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

const products = getProducts(Astro.currentLocale);
const siteUrl = new URL(homePath(Astro.currentLocale), Astro.site).toString();
const orgId = `${siteUrl}#organization`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': orgId, name: t('site.name'), description: t('site.orgDescription'), url: siteUrl, logo: new URL('/images/logo.png', Astro.site).toString() },
    {
      '@type': 'ItemList', name: t('products.listName'), numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem', position: i + 1,
        item: { '@type': 'SoftwareApplication', name: p.name, applicationCategory: 'WebApplication', operatingSystem: 'All', description: p.description, url: p.url, provider: { '@id': orgId } }
      }))
    }
  ]
};
---
<BaseLayout preloadImage="/images/club-meeting.webp" schema={schema}>
  <Hero />
  <div class="products-layout content-width">
    <ProductCollection products={products} />
    <ClubNotes />
  </div>
  <About />
</BaseLayout>

<style>
  .products-layout { display: grid; grid-template-columns: minmax(0, 2.15fr) minmax(0, 1fr); gap: 1rem; align-items: stretch; }
  @media (max-width: 66em) { .products-layout { grid-template-columns: minmax(0, 1fr); } }
</style>
