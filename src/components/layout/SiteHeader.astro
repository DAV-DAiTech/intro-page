---
import Button from '../ui/Button.astro';
import AccessibilitySettings from './AccessibilitySettings.astro';
import { getLocale, homePath, useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
const home = homePath(Astro.currentLocale);
const otherLocale = getLocale(Astro.currentLocale) === 'vi' ? 'en' : 'vi';
---
<header class="site-header content-width">
  <a class="brand" href={`${home}#top`} aria-label={t('header.homeLabel')}>
    <img src="/images/logo.png" alt="" width="42" height="42" />
    <span>{t('header.brand')}</span>
  </a>
  <nav aria-label={t('header.navLabel')}>
    <a href={`${home}#products`}>{t('header.products')}</a>
    <a href={`${home}#about`}>{t('header.story')}</a>
    <a class="language-switch" href={homePath(otherLocale)} lang={otherLocale} hreflang={otherLocale} rel="alternate">{otherLocale === 'vi' ? 'Tiếng Việt' : 'English'}</a>
  </nav>
  <div class="header-actions">
    <Button class="nav-cta" variant="canvas" href={`${home}#products`} icon="diagonal">{t('header.cta')}</Button>
    <AccessibilitySettings />
  </div>
</header>

<style>
  .site-header { padding-block: 1.5rem; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; color: var(--canvas-text); }
  .brand { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; min-width: 0; min-height: 44px; font-family: var(--font-heading); font-weight: var(--heading-weight); font-size: calc(1.25rem * var(--text-scale)); letter-spacing: -.055em; }
  .brand img { border-radius: 50%; width: 2.25rem; height: 2.25rem; }
  nav { display: flex; flex-wrap: wrap; justify-content: end; gap: .5rem 1.5rem; font-size: var(--text-ui); }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: .5rem 0; }
  nav a:hover { text-decoration: underline; text-underline-offset: .3em; }
  nav .language-switch { padding-inline: .875rem; border: 1px solid currentColor; border-radius: 99px; }
  .header-actions { display: flex; align-items: center; gap: .75rem; }
  @media (max-width: 70em) { .header-actions :global(.nav-cta) { display: none; } }
  @media (max-width: 44em) {
    .site-header { padding-block: 1rem; grid-template-columns: 1fr auto; gap: .5rem 1rem; }
    .brand { font-size: calc(1.125rem * var(--text-scale)); }
    nav { grid-row: 2; grid-column: 1 / -1; justify-content: start; }
  }
</style>
