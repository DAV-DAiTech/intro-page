---
import MembersPage from '../components/pages/MembersPage.astro';
import ProjectsPage from '../components/pages/ProjectsPage.astro';
import ShowcasePage from '../components/pages/ShowcasePage.astro';
import { clubPages, locales, pagePath, type ClubPage } from '../i18n';

export function getStaticPaths() {
  return locales.flatMap((locale) => clubPages.map((slug) => ({
    params: { clubPage: pagePath(locale, slug).slice(1, -1) },
    props: { slug }
  })));
}

interface Props { slug: ClubPage; }
const pages = { projects: ProjectsPage, showcase: ShowcasePage, members: MembersPage };
const Page = pages[Astro.props.slug];
---
<Page />
